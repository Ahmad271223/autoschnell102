{
  "manifest_version": 3,
  "name": "AutoSchnell Analyse und Vertragsabwicklung",
  "short_name": "AutoSchnell",
  "version": "2.7.2",
  "description": "AutoSchnell im Browser: Beim Öffnen eines Inserats gehen die Vergleiche mit euren Regeln auf, eine Ampel zeigt die Preislage, der Kaufvertrag geht mit einem Klick.",
  "minimum_chrome_version": "112",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AutoSchnell Analyse und Vertragsabwicklung",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://app.auto-schnellkauf.de/*",
    "https://www.kleinanzeigen.de/*",
    "https://kleinanzeigen.de/*",
    "https://suchen.mobile.de/*",
    "https://www.autoscout24.de/*",
    "https://www.autoscout24.at/*",
    "https://www.autoscout24.ch/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.auto-schnellkauf.de/*",
        "https://auto-schnellkauf.de/*",
        "https://www.auto-schnellkauf.de/*",
        "http://localhost/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://suchen.mobile.de/*",
        "https://www.autoscout24.de/*",
        "https://www.autoscout24.at/*",
        "https://www.autoscout24.ch/*",
        "https://www.kleinanzeigen.de/*"
      ],
      "js": [
        "gemeinsam.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://suchen.mobile.de/*",
        "https://www.autoscout24.de/*",
        "https://www.autoscout24.at/*",
        "https://www.autoscout24.ch/*",
        "https://www.kleinanzeigen.de/*"
      ],
      "js": [
        "portal.js"
      ],
      "run_at": "document_end"
    }
  ]
}
