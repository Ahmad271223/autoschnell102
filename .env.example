# ============================================================
#  AutoSchnell — Produktions-Konfiguration
#  Kopiere diese Datei nach  .env  und trage echte Werte ein.
#  (docker compose liest .env automatisch)
# ============================================================

# --- PFLICHT: Sicherheit (vor dem ersten Start setzen!) ---
# Langer Zufallswert, MINDESTENS 32 Zeichen (seit 19.09.2026 geprueft: in
# Produktion startet das Backend sonst nicht). Erzeugen mit:
#   openssl rand -hex 32     -> 64 Zeichen
# Auf ALLEN Servern derselbe Wert. Nach einem Wechsel muessen sich alle
# neu anmelden.
JWT_SECRET=BITTE-ERSETZEN-langer-zufallswert
# Optional (Runde 15): eigener Schluessel fuer Zwei-Faktor-Geheimnisse und bekannte
# Anmelde-IPs — dann macht eine JWT_SECRET-Rotation die MFA-Daten nicht unlesbar.
# Auf allen Servern gleich setzen: openssl rand -hex 32
# DATEN_SCHLUESSEL=
# Marktplatz-Schalter. Wunsch Ahmad 20.09.2026: WIEDER AUF (Standard true).
# Zum Schliessen genuegt MARKTPLATZ_AKTIV=false plus Rollout — der Code
# bleibt vollstaendig erhalten und die Oberflaeche zeigt dann wieder
# "Demnaechst verfuegbar".
MARKTPLATZ_AKTIV=true
# Runde 16: Versand je Konto (10 Minuten) und Bremse fuer direkte Anbieter-Abrufe
# VERSAND_JE_KONTO_10MIN=300
# ABRUF_JE_KONTO_MINUTE=60
# ABRUF_GLEICHZEITIG_JE_KONTO=8
# Runde 19: Vergleiche je Konto und Minute (auch Cache-Treffer; gegen Skripte)
# VERGLEICH_JE_KONTO_MINUTE=120

# Plattform-Betreiber = der einzige Admin (Anmeldung per Benutzername + 2FA).
# Kontonummer (13.09.2026): ein Bootstrap-Admin per E-Mail existiert nicht mehr.
# Benutzername mit Buchstaben (keine Kontonummer wie 10023), starkes Passwort!
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# --- PFLICHT: MongoDB-Zugangsdaten (docker-compose startet Mongo mit Auth) ---
MONGO_USER=autoschnell
MONGO_PASSWORD=BITTE-STARKES-DB-PASSWORT

# --- PFLICHT: Adressen der Plattform ---
# Links der Plattform (Einladungen, Vertragsmails) werden aus FRONTEND_URL gebaut.
FRONTEND_URL=https://autoschnell.de
CORS_ORIGINS=https://autoschnell.de,https://www.autoschnell.de

# --- Worker/Last (Server-Groesse) ---
# Anzahl Backend-Prozesse steht WEITER UNTEN bei PUBLIC_HOST (WEB_CONCURRENCY).
# Nachpruefung 20.09.2026 (N10): hier stand frueher eine ZWEITE Zuweisung mit
# einem anderen Wert (8 gegen 4). Beim Einlesen gewinnt die letzte — wer oben
# nachsah, las also den falschen Wert. Gefaehrlich, seit RESEND_PROZESSE
# (Worker x Server) daran haengt.
# Beweisdokument je Inserat (seit 10.09.2026, ohne Browser): gleichzeitige
# Erstellungen je Prozess, eingebettete Fotos, Aufbewahrung in Tagen.
# BEWEIS_PRIVATDATEN=1 druckt Name/Telefon auch privater Anbieter (dann
# Datenschutzerklaerung anpassen).
BEWEIS_PARALLEL=1
BEWEIS_FOTOS_MAX=20
BEWEIS_AUFBEWAHRUNG_TAGE=30
BEWEIS_PRIVATDATEN=

# --- E-Mail (Resend o.a. per SMTP) — fuer 'Passwort vergessen' ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=BITTE-RESEND-API-KEY
SMTP_FROM=AutoSchnell <info@autoschnell.de>

# --- Speicher / Aufbewahrung ---
# Snapshots verfallen nach so vielen Tagen (Vertrags-Snapshots bleiben).
SNAPSHOT_RETENTION_DAYS=60
# Kaufvertraege (Verkaeufer-Personendaten, PDF, Versionen) werden nach dieser
# Frist vollstaendig geloescht. Die anonymen Auto-Daten (admin_vehicle_data:
# Marke/Modell/EZ/km/Kraftstoff/PS/kW/Kaufpreis/Kaufdatum/Schaeden) bleiben dauerhaft.
VERTRAG_AUFBEWAHRUNG_TAGE=60
# Fristloeschung scharf schalten? false = TROCKENLAUF: der Job zaehlt
# nur, protokolliert die Kandidaten und legt eine Vorschau in system_reports
# (typ vertrag_loeschvorschau) ab, loescht aber NICHTS. Erst nach Pruefung mit
# scripts/vertraege_bestand_pruefen.py auf true setzen. Geloescht wird dann nur,
# wenn der dauerhafte Auto-Datensatz existiert (sonst Betriebsalarm).
# Entscheidung Ahmad 14.09.2026: scharf. Hinweis: Kaufvertraege sind Buchungsbelege
# mit gesetzlicher Aufbewahrungspflicht — vorher ins Buchhaltungsarchiv exportieren.
VERTRAG_LOESCHUNG_AKTIV=true
# Erledigte/abgelehnte Zugangs- und Abo-Anfragen (Kontaktdaten) nach Tagen loeschen.
ANFRAGEN_AUFBEWAHRUNG_TAGE=60

# --- Client-seitiges Abrufen (nur Kleinanzeigen) ---
# true = neue Kleinanzeigen-Seiten holt der BROWSER DES NUTZERS (ueber die
# AutoSchnell-Erweiterung), nicht der Server -> keine Server-Sperre bei
# Massen-Vergleichen. Erst einschalten, wenn die Erweiterung an die Sucher
# verteilt ist (siehe browser-extension/). Aus = Server holt selbst (Default).
# mobile.de/AutoScout sind davon NIE betroffen (offizielle API).
CLIENT_FETCH_KLEINANZEIGEN=false

# --- OPTIONAL: Proxy fuers Abrufen (Alternative/Ergaenzung) ---
# Nur relevant, solange der Server selbst abruft (CLIENT_FETCH aus).
PROXY_ENABLED=false
PROXY_URL=


# --- Anbieter-Abrufe: mobile.de + AutoScout24 ueber Apify ---
# Token: console.apify.com -> Settings -> API & Integrations
APIFY_TOKEN=

# --- OPTIONAL: offizielle mobile.de API (statt/zusaetzlich zu Apify) ---
MOBILE_API_USER=
MOBILE_API_PASS=

# HINWEIS: TRUST_PROXY=true und RATE_LIMIT_EXEMPT_LOOPBACK=false werden im
# docker-compose.yml bereits fest gesetzt (der nginx-Proxy reicht die echte
# Client-IP weiter) — hier nichts zu tun.

# --- Pruefbericht Runde 4 (09/2026) ---
# Client-Einreichungen (Kleinanzeigen-HTML aus dem Browser des Nutzers) bleiben
# strikt beim einreichenden Haendler. Eine globale Freigabe an ALLE Haendler
# gibt es nur, wenn hier eine Mindestzahl unabhaengiger Haendler (>= 3)
# gesetzt ist — sonst koennte sich jemand mit zwei Konten gefaelschte Daten
# selbst "bestaetigen". Standard 0 = nie freigeben.
CLIENT_INGEST_PROMOTE_MIN_DEALERS=0
# Schadens-FREITEXT dauerhaft in den Auto-Daten speichern? Namen oder
# ungewoehnlich geschriebene Personendaten erkennt kein Filter sicher.
# false (Standard seit Go-Live-Audit 09/2026) = nur die vordefinierten
# Skizzen-Bezeichnungen, kein Freitext. Altbestand bereinigen:
# python scripts/schaeden_freitext_bereinigen.py [--anwenden]
AUTO_DATEN_SCHAEDEN_FREITEXT=false
# Client-Fehlerberichte: URL-Query wird nie protokolliert.
# Aufbewahrung von Audit-Log (activity_logs) und erledigten Fehlerberichten in
# Tagen; abgelaufene Job-Sperren werden ebenfalls entfernt (Review 09/2026).
LOG_AUFBEWAHRUNG_TAGE=60
# OFFENE Fehlerberichte verfallen nach so vielen Tagen; ERROR_LOG_MAX ist der
# harte Deckel des Fehlerarchivs (darueber fliegen die aeltesten Eintraege).
LOG_AUFBEWAHRUNG_TAGE_OFFEN=60
ERROR_LOG_MAX=20000

# --- Betreiber-Freischaltung (09/2026) ---
# Firmen registrieren sich nicht mehr selbst: Startseite bietet nur eine
# Zugangs-Anfrage, der Betreiber legt Konten + Sucher im Admin an.
# Kontonummer (13.09.2026): Firmen, Sucher, Kaeufer und Fahrer legt nur der
# Betreiber an — eine Selbst-Registrierung gibt es nicht mehr.

# Fahrzeugpool (Wunsch 09/2026): je Firma bleiben nur die neuesten N
# verglichenen Fahrzeuge (Vertraege/Termine/Inserate sind geschuetzt)
FAHRZEUGPOOL_MAX_VERGLEICHE=30

# ---- Audit 09/2026: Proxy, Ressourcen, Dateien, Offsite-Backup ----
# Oeffentliche Domain (Host-Allowlist im Proxy; alles andere -> 444)
PUBLIC_HOST=app.autoschnell.de
# Kanonische API-URL (falls je eine absolute URL gebraucht wird, z.B. Stripe)
PUBLIC_API_URL=https://app.autoschnell.de/api
# Backend-Prozesse (kein Browser mehr, ~400 MB je Prozess). Faustregel: Anzahl
# CPU-Kerne — CCX23=4, CPX41=8, CCX43=16.
# ACHTUNG beim Aendern: RESEND_PROZESSE = WEB_CONCURRENCY x Anzahl Server.
# Bleibt RESEND_PROZESSE zu klein, laesst der Mail-Takt zu viel gleichzeitig
# durch und Resend weist ab (siehe RESEND_RATE weiter unten).
WEB_CONCURRENCY=4
# Mongo-Verbindungspool je Worker begrenzen (in MONGO_URL: ...&maxPoolSize=20)
# Nicht-oeffentliche Dateien (Fahrzeugfotos) nur mit kurzlebiger Signatur.
# In Produktion Pflicht: false bricht den Start ab (Produktions-Check,
# Runde 13) — der Uebergangsschalter hat keinen Zweck mehr, alle Foto-Links
# werden signiert erzeugt. Firmenlogos (logo/) bleiben oeffentlich.
DATEI_SIGNATUR_PFLICHT=true
DATEI_LINK_TTL_SEKUNDEN=3600
# Readiness: Mindest-Speicherplatz (MB) fuer Uploads/Snapshots/Backups
MIN_FREI_MB=500
# Inserats-Zwischenspeicher (kann Verkaeuferangaben enthalten): 14 Tage, danach
# neuer Abruf; geloescht spaetestens 21 Tage nach dem Abruf (Wunsch Ahmad 19.09.2026).
# Wer einen Vertrag macht, behaelt den Inseratsstand am Vertrag.
LISTING_CACHE_TTL_HOURS=336
# Sofort-Anstoesse fuer Link-Abrufe je Prozess (Rest macht der Dauer-Worker)
LINK_JOB_SOFORT_MAX=4
# Pruefung 14.09.2026: In Produktion ist ein gemeinsamer S3/R2-Speicher Pflicht
# (zwei Server). Ein EINZELserver mit lokaler Platte setzt ausdruecklich:
# STORAGE_LOKAL_ERLAUBT=true
# Hinter nginx/Load Balancer ist TRUST_PROXY=true in Produktion Pflicht
# (sonst sieht das Backend nur die Proxy-Adresse).
# TRUST_PROXY=true

# Offsite-Backup (verschluesselt, S3-kompatibel; Object Lock nur mit
# entsprechend konfiguriertem Bucket)
BACKUP_S3_BUCKET=
# Eigene Adresse fuer den Sicherungs-Bucket. Noetig, wenn er in einer
# anderen Zone liegt als der Datei-Bucket — bei Cloudflare R2 hat ein
# Bucket mit EU-Zone die Adresse <konto>.eu.r2.cloudflarestorage.com und
# ist ueber die Standard-Adresse NICHT erreichbar. Leer = wie S3_ENDPOINT.
BACKUP_S3_ENDPOINT=
# Eigene Zugangsdaten NUR fuer den Sicherungs-Bucket (Phase 3, 15.09.2026):
# Berechtigung "Object Read & Write", eingeschraenkt auf den Sicherungs-Bucket.
# Rein schreibend genuegt NICHT: der Upload prueft die Groesse, die Rotation
# listet und loescht alte Archive, die Dateikopie fuehrt einen Papierkorb.
# Leer = die S3_*-Zugangsdaten (dann warnt /api/ready).
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=autoschnell-backups/
BACKUP_S3_OBJECT_LOCK_DAYS=
BACKUP_S3_KEEP=14
# Snapshot-Pflicht: true = eine Sicherung gilt NUR als gut, wenn alle
# Collections in EINER Snapshot-Sitzung gelesen wurden (gemeinsamer
# Zeitpunkt). Bei einer MONGO_URL mit replicaSet=... erkennt der Code das
# ohnehin selbst — dieser Schalter ist fuer alle anderen Faelle.
BACKUP_SNAPSHOT_PFLICHT=
# Schreibpause waehrend der naechtlichen Sicherung. Standard AUS; nur "true"
# schaltet sie ein. KORREKTUR 20.09.2026: Hier stand kurzzeitig "leer =
# automatisch, sobald kein Replica Set laeuft". Das war falsch — die Pause
# haelt die ganze Plattform fuer die Dauer des Dumps an (Lesen geht weiter,
# Schreiben bekommt 503) und sie haette taeglich zugeschlagen.
# Der saubere Weg zu einer stichtagsgenauen Sicherung ist Mongo als Replica
# Set: dann werden alle Collections in EINER Snapshot-Sitzung gelesen, ohne
# jede Unterbrechung. /api/ready sagt es, wenn das fehlt.
BACKUP_WARTUNG=
# Wartezeit nach dem Einschalten, bis alle Prozesse die Pause sehen und
# laufende Anfragen fertig sind (Sekunden, Standard 30, Minimum 6).
BACKUP_WARTUNG_WARTEN_S=
# Ablaufzeit des Pause-Merkers in Minuten (Standard 15). Der laufende
# Sicherungslauf verlaengert sie jede Minute; stuerzt er ab, laeuft sie von
# selbst ab und die Plattform ist wieder frei.
BACKUP_WARTUNG_FRIST_MIN=
# Dasselbe aus Sicht des Backends (Standard 30): so lange gilt ein frisch
# gesetzter Wartungsmodus hoechstens ohne Verlaengerung.
WARTUNG_FRIST_MIN=
# Datei-Speicher sichern (19.09.2026): "bucket" = jede Datei wandert
# Speicher-zu-Speicher in den Sicherungs-Bucket (Praefix dateien/), OHNE
# Umweg ueber die Serverplatte; geloeschte Dateien bleiben dort 30 Tage als
# Papierkorb. "spiegel" = alter Weg (ganzer Bucket in jedes lokale Backup —
# fuellt bei grossen Datei-Speichern die Platte). "aus" = nicht sichern.
# Leer = bucket, sobald ein Sicherungs-Bucket gesetzt ist, sonst spiegel.
BACKUP_DATEIEN=
BACKUP_DATEIEN_BUCKET=
BACKUP_DATEIEN_PREFIX=dateien/
BACKUP_DATEIEN_AUFBEWAHRUNG_TAGE=30

# ---- Abruf-Grenzen und Betrieb (Audit 09/2026) ----
# Kostenpflichtige Anbieter-Abrufe (mobile.de/AutoScout via Apify) je Tag
# Kostenpflichtige Abrufe bei mobile.de/AutoScout (ca. 0,5 Cent je Abruf).
# 0 = KEIN Limit. Gezaehlt wird trotzdem; ab ANBIETER_TAGESWARNUNG gibt es
# EINEN Betriebsalarm am Tag, damit hohe Kosten auffallen ohne zu bremsen.
ANBIETER_TAGESLIMIT_JE_FIRMA=0
ANBIETER_TAGESLIMIT_GESAMT=0
# Je Konto (Entscheidung Ahmad 16.09.2026): hoechstens 400 neue Abrufe am
# Tag, alle Quellen. Bekannte Links aus dem Speicher zaehlen nicht. 0 = aus.
ANBIETER_TAGESLIMIT_JE_KONTO=400
# 21.09.2026: 5000 statt 500 — erwartet sind 1.000–3.240 Abrufe am Tag
# (30 Sucher); bei 500 kaeme der Hinweis samt Betriebsmail jeden Tag.
ANBIETER_TAGESWARNUNG=5000
# Serverseitiger Rueckfall, wenn der Nutzer die Browser-Erweiterung nicht hat
# Rueckfall-Abrufe je SUCHER und Tag (nicht je Firma — Runde 26): jedes
# Konto hat sein eigenes Budget, niemand bremst einen Kollegen aus.
ABRUF_RUECKFALL_TAGESLIMIT=25

# Anmeldeversuche je Minute und oeffentlicher IP (Netz-Schutz gegen
# Rateversuche). Das eigentliche Limit haengt am KONTO (10/min); dieser
# Wert muss zu einem Buero mit vielen Suchern passen.
LOGIN_IP_LIMIT=120

# Kontonummer (13.09.2026): Fehlversuche je Kontonummer OHNE IP-Bezug
# (Schutz gegen Rateversuche ueber viele IPs, Nummern sind fortlaufend).
# Ab LOGIN_KONTO_LIMIT Fehlversuchen im Fenster (Sekunden) antwortet der
# Login 429 — ausser von IPs, an denen sich das Konto schon angemeldet hat.
# Passwort-Setzen durch den Betreiber hebt die Sperre auf.
# 0 = nie sperren, nur Betriebsalarm "login_konto_angegriffen".
LOGIN_KONTO_LIMIT=30
LOGIN_KONTO_FENSTER=900

# Link-Warteschlange: offene Jobs je SUCHER und je Firma. Verhindert, dass
# ein einzelnes Konto die Warteschlange fuellt; der Worker bedient die
# Konten ohnehin reihum (Runde 28).
LINK_JOB_MAX_OFFEN_JE_KONTO=20
LINK_JOB_MAX_OFFEN_JE_FIRMA=100
# Wie viele wartende Konten die Reihum-Auswahl je Durchgang betrachtet.
LINK_JOB_KANDIDATEN=200
# Hoechstlaufzeit eines Abrufs in Sekunden, solange der Herzschlag die
# Frist verlaengert; danach stellt die Selbstheilung den Job zurueck.
LINK_JOB_HERZSCHLAG_MAX=900

# Kleinanzeigen-Inserate ueber die API von kleinanzeigen-agent.de
# (Runde 29, 12.09.2026). Mit Schluessel wird sie ZUERST gefragt: gemessen
# 0,4 s je Inserat statt mehrerer Sekunden, strukturierte Daten samt
# Verkaeufername, und Kleinanzeigen blockt uns nicht. OHNE Schluessel
# laeuft unveraendert der eigene Abruf — der bleibt ohnehin die Notloesung,
# falls die API stoert. Schluessel: https://kleinanzeigen-agent.de/app
KLEINANZEIGEN_API_KEY=
# Nur aendern, wenn der Anbieter die Version wechselt.
KLEINANZEIGEN_API_URL=https://api.kleinanzeigen-agent.de/api/v2/kleinanzeigen
KLEINANZEIGEN_API_TIMEOUT=12
# Gleichzeitige Abrufe ueber die API. Die API erlaubt 600 Anfragen je
# Minute; 8 gleichzeitige beantwortet sie in 0,56 s (gemessen).
MAX_CONCURRENT_KLEINANZEIGEN_API=20

# Vorschaubilder je Minute und IP. Ein Vergleich laedt bis zu 40 Bilder;
# 30 Sucher hinter einer Firmen-IP brauchen entsprechend Luft.
BILD_PROXY_LIMIT=3000

# ---- Weiterverkauf / Marktplatz (Regeln 20.09.2026) ----
# Beschreibung eines Inserats (Zeichen).
INSERAT_BESCHREIBUNG_MAX=500
# Hoechstens so viele EIGENE Fotos je Inserat. Fotos aus dem
# urspruenglichen Portal-Inserat werden NICHT mehr uebernommen — sie
# gehoeren dem Verkaeufer bzw. dem Portal.
INSERAT_FOTOS_MAX=10
# Laufzeit eines veroeffentlichten Inserats in Tagen. Danach
# verschwindet die Anzeige samt ihrer Fotos von selbst. Kaufvertrag,
# Kaufvorgang und Fahrzeugakte bleiben davon unberuehrt.
INSERAT_LAUFZEIT_TAGE=21
# /api/ready ist ein teurer Betriebscheck (DB-Ping, Indexe, Platte,
# Datei-Speicher). Das Ergebnis wird so viele Sekunden
# zwischengespeichert; 0 = jeder Aufruf rechnet neu.
READY_CACHE_S=5

# Beweisdokument: Groesse der eingebetteten Inseratsfotos (Runde 26 kleiner,
# 9 Fotos ergeben rund 370 statt 670 KB). Erstes Foto etwas groesser.
BEWEIS_FOTO_KANTE_ERSTE=1000
BEWEIS_FOTO_KANTE=640
BEWEIS_FOTO_QUALITAET_ERSTE=68
BEWEIS_FOTO_QUALITAET=62

# Gespeicherte Fotos (Inserat, Abholbericht, Logo) werden beim Hochladen
# immer auf diese Kantenlaenge/Qualitaet gebracht — Originale werden nie
# aufgehoben.
MAX_IMAGE_EDGE=1600
IMAGE_QUALITY=80
# Gleichzeitige Abrufe je Anbieter — gelten GLOBAL ueber alle Prozesse und
# beide Server (Zaehler in der Datenbank). Lasttest 16.09.2026: bei N neuen
# Links, die gleichzeitig eintreffen, wartet der letzte etwa
# (N / Slots) x Abrufdauer (mobile.de/AutoScout ueber Apify 8-20 s je Inserat,
# Kleinanzeigen-API 1-3 s). Beispiel: 60 neue mobile.de-Links auf einmal mit
# 20 Slots -> der letzte wartet ~3 Abrufdauern. Hoehere Werte nur, wenn der
# Apify-Plan so viele gleichzeitige Actor-Laeufe erlaubt.
MAX_CONCURRENT_KLEINANZEIGEN=2
# mobile.de und AutoScout24 laufen BEIDE ueber Apify — ihre Summe darf
# APIFY_MAX_PARALLEL nicht uebersteigen (Starter-Plan: 32). Gemessen mit
# backend/scripts/lasttest_apify_grenze.py: 20+20 -> 8 von 40 Suchern sahen
# einen Fehler, 16+16 -> null. Kleinanzeigen zaehlt nicht mit.
# Seit dem gemeinsamen Apify-Topf darf jede Quelle bis zum vollen Plan —
# zusammen deckelt APIFY_MAX_PARALLEL. So liegen keine Plaetze brach.
MAX_CONCURRENT_MOBILE=32
MAX_CONCURRENT_AUTOSCOUT=32
APIFY_MAX_PARALLEL=32
# Abstand, bevor ein wegen Tempolimit (429) abgewiesener Abruf erneut startet.
LINK_JOB_TEMPOLIMIT_WARTEN=5
# Sicherung: hoechste Wartezeit auf ein echtes Auslaufen der Schreibzugriffe.
BACKUP_AUSLAUFEN_MAX_S=120
# Nachlese nach dem Loeschen eines Suchers (Minuten).
KONTO_NACHLESE_FENSTER_MIN=30
# Apify-Actors (nur noetig, wenn abweichend vom Standard)
APIFY_MOBILE_ACTOR=
APIFY_AUTOSCOUT_ACTOR=
# Groesstes erlaubtes EINZELNES Foto (Bytes) — Standard 8 MB.
# Nicht verwechseln mit dem Limit fuer die GANZE Anfrage: das setzt
# nginx in deploy/nginx.conf (client_max_body_size 25m). Mehrere Fotos
# in einem Aufruf muessen zusammen darunter bleiben.
MAX_IMAGE_UPLOAD_BYTES=8388608
# Aussteller-Name in der Authenticator-App
MFA_AUSSTELLER=AutoSchnell

# ---- Betriebsmeldungen (20.09.2026) ----
# An diese Adresse geht eine Mail, sobald ein NEUER Betriebsalarm
# entsteht (bezahlt ohne Zugang, Sicherung unvollstaendig, Vertrag ohne
# Datensatz ...) — und einmal taeglich ein Tagesbericht, AUCH wenn
# alles in Ordnung ist: bleibt die Mail aus, stimmt etwas nicht.
# LEER = keine Meldungen; Fehler sind dann nur auf der Betriebs-Seite
# und in /api/ready sichtbar.
BETRIEB_MELDUNG_AN=
# Pruefbericht 20.09.2026 (AL-04): hoechstens so viele offene Einzelalarme je
# Typ (darueber zaehlt ein Sammelalarm weiter); geschlossene Alarme werden nach
# ALARM_AUFBEWAHRUNG_TAGE automatisch geloescht.
ALARM_JE_TYP_MAX=100
ALARM_AUFBEWAHRUNG_TAGE=90
# Sammelfrist in Minuten (Standard 10): zehn Alarme in derselben
# Minute ergeben EINE Mail, nicht zehn.
BETRIEB_MELDUNG_SOFORT_MIN=10
# Stunde des Tagesberichts (Standard 8). -1 schaltet nur ihn ab,
# die Sofortmeldungen bleiben.
BETRIEB_TAGESBERICHT_STUNDE=8
# Rate-Limits: nur zum lokalen Testen abschalten, NIE in Produktion
RATE_LIMIT_ENABLED=true
# Hinter einem Proxy (nginx) die echte Client-IP aus X-Forwarded-For lesen
TRUST_PROXY=true
# Eigene Vermittler als Netze (Komma-Liste). Noetig, sobald MEHR als ein
# Proxy davorsteht, z.B. Cloudflare -> Load Balancer -> nginx. Ohne diese
# Angabe saehen alle Besucher wie der Load Balancer aus und eine einzige
# fehlgeschlagene Anmeldung wuerde alle aussperren.
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12,10.0.0.0/16
# Betriebsart des Webservers:
#   default.conf.template             = nginx macht TLS selbst (ein Server)
#   hinter-loadbalancer.conf.template = Load Balancer macht TLS
PROXY_TEMPLATE=default.conf.template
# Privates Netz des Anbieters — nur von dort wird X-Forwarded-For geglaubt
PRIVATES_NETZ=10.0.0.0/16
# Interne Warteschlange fuer Link-Abrufe: gleichzeitige Jobs JE PROZESS
# (Prozesse: WEB_CONCURRENCY). Ein wartender Job kostet nichts — die echte
# Grenze setzen die Anbieter-Slots oben. Lasttest 16.09.2026: 32.
LINK_JOB_CONCURRENCY=32
LINK_JOB_MAX_ATTEMPTS=3
# API-Dokumentation (/docs) — in Produktion aus lassen
ENABLE_DOCS=false
# Nur fuer Tests: liefert erfundene Fahrzeugdaten statt echter Abrufe
MOCK_PROVIDER_FETCH=false
MOBILE_SANDBOX_MODE=false

# ---- E-Mail-Versand (Resend bevorzugt) ----
# Schluessel aus resend.com; die Absender-Domain muss dort verifiziert sein.
RESEND_API_KEY=
# Absenderadresse ALLER Mails (Vertraege, Passwort-Reset). Muss zur
# verifizierten Domain gehoeren — der Anzeigename wird je Mail gesetzt.
MAIL_FROM=AutoSchnell <vertrag@deine-domain.de>
# Anzeigename der Plattform (erscheint als "Firma ueber <Name>")
MAIL_ABSENDER_NAME=AutoSchnell
# Verkaufen von Fahrzeugen: kostenlos und unbegrenzt (false = Pakete/Kontingent)
VERKAUF_KOSTENLOS=true
# Marktplatz kostenlos und oeffentlich: oeffentlich veroeffentlichte
# Fahrzeuge sind ohne Anmeldung sichtbar, Zwischenhaendler brauchen kein
# Zugangs-Abo. false = wieder kostenpflichtig und nur fuer Angemeldete.
MARKTPLATZ_KOSTENLOS=true

# ---- Zweiter Server (Replikat ueber zwei Maschinen, DEPLOYMENT.md) ----
# Nur noetig, wenn mit deploy/docker-compose.replica.yml gestartet wird.
# Auf JEDEM Server eigene Werte fuer PRIVATE_IP und MONGO_NAME.
#PRIVATE_IP=10.0.0.2
#MONGO_NAME=mongo-prod1
#PROD1_IP=10.0.0.2
#PROD2_IP=10.0.0.3
# MONGO_URL dann mit BEIDEN Mitgliedern:
#MONGO_URL=mongodb://autoschnell_app:PASSWORT@mongo-prod1:27017,mongo-prod2:27017/?authSource=admin&replicaSet=rs0&maxPoolSize=20
# WICHTIG (Nachpruefung 20.09.2026, Nr. 28): Ohne die naechste Zeile startet
# mongod OHNE Replica Set, und das im Handbuch beschriebene rs.initiate()
# scheitert mit "not running with --replSet". Die Zeile schaltet es ein; die
# Schluesseldatei ist Pflicht, sobald --auth aktiv ist (steht es schon).
# Auf JEDEM Mongo-Server setzen, mit DERSELBEN Schluesseldatei:
#MONGO_EXTRA_ARGS=--replSet rs0 --keyFile /etc/mongo-keyfile
# Ein-Server-Replikat (nur damit die Sicherung stichtagsgenau wird, ohne
# zweiten Server): dieselbe Zeile, dann rs.initiate() mit nur einem Mitglied.
# Damit JEDES "docker compose up" die Replikat-Ergaenzung mitnimmt (Vorfall
# 07.09.2026: ein Neustart ohne "-f deploy/docker-compose.replica.yml" liess
# das Backend mongo-prod1/mongo-prod2 nicht mehr aufloesen und nahm das
# Mongo-Mitglied aus dem Replikat):
#COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.replica.yml

# Optional: DKIM-Selector des Mail-Anbieters (Resend: "resend") — die Betriebsprobe
# am Ende von deploy/rollout.sh prueft damit auch DKIM.
#DKIM_SELECTOR=resend
